  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.png",
  "files": [
    "lib",
    "assets",
    "defaults",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komeiji-cobalt/dsh-isaac-widget.git"
  },
  "bugs": {
    "url": "https://github.com/komeiji-cobalt/dsh-isaac-widget/issues"
  },
  "homepage": "https://github.com/komeiji-cobalt/dsh-isaac-widget#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
